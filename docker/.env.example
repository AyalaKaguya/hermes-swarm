# Optional local Docker infrastructure only.
# Copy this file to docker/.env before running docker compose from this folder.

POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_dev_pwd
POSTGRES_DB=hermes
POSTGRES_PORT=5432

REDIS_PASSWORD=hermes_redis_pwd
REDIS_PORT=6379

# Optional `storage` profile only. Root credentials initialize local MinIO;
# Hermes itself uses the independent application credentials below.
MINIO_ROOT_USER=hermes_minio_root
MINIO_ROOT_PASSWORD=replace-with-a-long-local-root-password
MINIO_APP_ACCESS_KEY=hermes_local_app
MINIO_APP_SECRET_KEY=replace-with-a-long-local-app-secret
MINIO_BUCKET=hermes-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3100
