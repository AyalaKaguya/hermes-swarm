# ============================================
# Hermes Swarm — Development Environment
# ============================================
# Copy to project root .env (app runtime config):
#   cp .env.example .env
#

# ---- App Runtime ----
API_PORT=3200
CORS_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:3200/api
# Increase this only for high-latency development or test environments.
NEXT_PUBLIC_ADMIN_API_TIMEOUT_MS=30000
# Generate independent random values of at least 32 bytes for every secret.
# Production startup rejects missing, reused, or obvious placeholder values.
AUTH_SESSION_SECRET=replace-with-an-independent-random-auth-session-secret
AUTH_SESSION_KEY_ID=primary
# JSON object of retired key IDs to secrets; keep only during the session
# rotation window. Example: {"previous":"old-random-secret"}
AUTH_SESSION_PREVIOUS_KEYS={}
WEB_SESSION_SECRET=replace-with-an-independent-random-web-session-secret
INVITE_TOKEN_SECRET=replace-with-an-independent-random-invite-token-secret
PASSWORD_RESET_TOKEN_SECRET=replace-with-an-independent-random-password-reset-token-secret
# Dedicated AES-256-GCM keyring for encrypted settings. New writes use the
# active key ID; old keys remain read-only until values have been re-encrypted.
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-settings-key
SETTINGS_ENCRYPTION_KEY_ID=primary
SETTINGS_PREVIOUS_ENCRYPTION_KEYS={}
# Exact OpenAI-compatible hosts that Provider records may target. Include a
# non-default port when required. An empty list rejects every Provider URL.
# AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,models.example.com:8443
# Outbound Tool Connections require HTTPS by default. This escape hatch is
# honored only when NODE_ENV=development and must never be enabled elsewhere.
AI_TOOL_ALLOW_HTTP_IN_DEVELOPMENT=false
# Comma-separated IPs/CIDRs of the reverse proxies that connect directly to the
# API. Forwarded/X-Forwarded-For and CDN client-IP headers are ignored unless the
# TCP peer matches this list. The last trusted proxy must overwrite or sanitize
# incoming forwarding headers. Example for a local Next.js BFF:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ---- PostgreSQL ----
# Hermes uses one application database URL and one TypeORM connection pool.
POSTGRES_URL=postgresql://hermes:hermes_dev_pwd@localhost:5432/hermes

# ---- Database Synchronization ----
# Schema changes are migration-only in every environment.
DATABASE_SYNCHRONIZE=false
# Dedicated, disposable remote database URL used only by tests when NODE_ENV=test.
# API E2E resets its public schema; never reuse the production database URL.
# POSTGRES_TEST_URL=postgresql://hermes:hermes_dev_pwd@localhost:5432/hermes-test

# ---- Development Seed (never use for production onboarding) ----
# One global account receives Platform Admin, primary Workspace Owner, and lab
# Workspace Admin memberships. The password has no default and must be supplied.
DEV_SEED_ADMIN_NAME=Platform Admin
DEV_SEED_ADMIN_EMAIL=admin@hermes.local
# DEV_SEED_ADMIN_PASSWORD=replace-with-a-development-password-of-at-least-8-characters
DEV_SEED_WORKSPACE_NAME=Hermes Development
DEV_SEED_WORKSPACE_SLUG=hermes-dev

# ---- Redis ----
# One complete Redis endpoint used by sessions, rate limits, realtime events,
# job locks, settings cache, and the TypeORM query cache. `rediss://` is
# supported for managed TLS Redis services.
REDIS_URL=redis://:hermes_redis_pwd@localhost:6379
# REDIS_HOST, REDIS_PORT, and REDIS_PASSWORD remain a compatibility fallback
# only when REDIS_URL is absent. Put Docker-only values in docker/.env.

# ---- Durable Runtime Worker ----
# The Worker uses the same POSTGRES_URL and REDIS_URL as the API, but owns an
# independent database pool and BullMQ connections. It never runs migrations.
WORKER_HEALTH_PORT=3210
WORKER_CONCURRENCY=4
RUNTIME_QUEUE_NAME=runtime
RUNTIME_QUEUE_PREFIX=hermes
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_POLL_MS=1000
OUTBOX_RECONCILE_MS=60000
WORKER_SHUTDOWN_GRACE_MS=30000

# ---- Object Storage ----
# Disabled by default so the API can be deployed before a private S3-compatible
# bucket is provisioned. Once enabled, every value below is required.
OBJECT_STORAGE_ENABLED=false
# OBJECT_STORAGE_ENDPOINT=https://minio.example.com
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=hermes-files
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MAX_UPLOAD_BYTES=104857600
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
OBJECT_STORAGE_PENDING_TTL_SECONDS=86400

# ---- TypeORM Query Cache ----
TYPEORM_CACHE_ENABLED=true
TYPEORM_CACHE_DURATION_MS=30000
TYPEORM_CACHE_ALWAYS_ENABLED=false
TYPEORM_CACHE_IGNORE_ERRORS=true
