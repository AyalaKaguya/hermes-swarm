{
  "name": "@hermes-swarm/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const {rmSync}=require('node:fs'); for (const path of ['dist','tsconfig.tsbuildinfo']) rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@hermes-swarm/agent-sdk": "workspace:*",
    "@hermes-swarm/api-contracts": "workspace:*",
    "@hermes-swarm/core": "workspace:*",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "bullmq": "5.81.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0",
    "zod": "4.4.3"
  },
  "nx": {
    "projectType": "application",
    "tags": ["type:app", "scope:backend", "layer:runtime"],
    "targets": {
      "start": {
        "continuous": true,
        "cache": false,
        "dependsOn": ["build"]
      },
      "dev": {
        "continuous": true,
        "cache": false,
        "dependsOn": ["^build"]
      },
      "coverage": {
        "command": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" \"src/**/*.test.ts\"",
        "dependsOn": ["build"],
        "options": {
          "cwd": "apps/worker"
        }
      }
    }
  }
}
